exam.jdlc-mikemy.tech {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	# Vidéo de présentation (fichier statique)
	handle /video/* {
		reverse_proxy exam-video:80
	}
	# Application Streamlit (WebSockets compris)
	handle {
		reverse_proxy exam-app:8501
	}
}
